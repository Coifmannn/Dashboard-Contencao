{
  "name": "painel-contencao",
  "version": "2.0.69",
  "description": "Dashboard Desktop Nativo de Contenção & Metas Salesforce",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win",
    "build-dir": "electron-builder --win --dir",
    "release": "node scripts/release.js"
  },
  "keywords": [
    "electron",
    "salesforce",
    "contencao",
    "dashboard"
  ],
  "author": "Grupo Ideal Trends",
  "license": "UNLICENSED",
  "build": {
    "appId": "com.idealtrends.painelcontencao",
    "productName": "Painel de Contenção",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Painel-Contencao-Setup-${version}.${ext}"
    },
    "nsis": {
      "differentialPackage": false,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Painel de Contenção"
    },
    "publish": {
      "provider": "generic",
      "url": "https://www.mpitemporario.com.br/projetos/DashContencao-releases/"
    },
    "forceCodeSigning": false,
    "asar": false,
    "files": [
      "src/**/*",
      "assets/**/*",
      "data/**/*",
      "package.json",
      ".env"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ]
  },
  "devDependencies": {
    "@noble/hashes": "^1.8.0",
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3",
    "electron-reload": "^1.2.3"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "electron-updater": "^6.8.9",
    "firebase": "^9.14.0"
  }
}
